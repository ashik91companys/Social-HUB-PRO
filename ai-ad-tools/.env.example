# Example environment variables for AI Ad Tools

# Text provider (OpenAI)
OPENAI_API_KEY=

# Image provider (Replicate)
REPLICATE_API_TOKEN=

# S3-compatible storage (optional)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/ai_ads

# App
NODE_ENV=development
PORT=4000
